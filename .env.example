# MySQL profile (optional; default profile uses H2)
DB_URL=jdbc:mysql://localhost:3306/team_toolbox?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=change-me

# Replace with a long random value outside local development
JWT_SECRET=replace-with-at-least-32-random-characters

# Local file storage
STORAGE_LOCATION=../storage

# Frontend development proxy
VITE_API_TARGET=http://localhost:8080
